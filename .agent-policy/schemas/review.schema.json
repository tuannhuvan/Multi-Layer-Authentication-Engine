{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Agent V2.1 Review Output Schema (Appendix B)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "role",
    "story_id",
    "candidate_sha",
    "baseline_manifest_sha256",
    "mode",
    "verdict",
    "checked_scope",
    "findings"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": ["BIZ", "SEC"]
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "baseline_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": ["FULL", "DELTA"]
    },
    "previous_review_id": {
      "type": "string"
    },
    "closed_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "checked_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "blocking",
          "reference",
          "location",
          "message",
          "evidence",
          "resolution_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "category": {
            "enum": ["SPEC", "DESIGN", "TEST", "CODE", "INFRA", "POLICY"]
          },
          "blocking": {
            "type": "boolean"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "resolution_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
